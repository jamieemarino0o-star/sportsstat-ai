PORT=3000
HOST=127.0.0.1
ODDS_API_KEY=
# Optional: milliseconds between upstream Odds API polls (default 1800000 = 30 minutes).
# Raise this, or leave it default, on a free-tier plan to conserve monthly credits.
ODDS_POLL_INTERVAL_MS=
# Optional: Telegram notifications for new model picks and final results.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# IANA time zone for notification dates/times (e.g. America/New_York). Defaults to UTC.
TELEGRAM_TIME_ZONE=UTC
# Optional: only announce new bets with EV% at or above this value (e.g. 3). Unset = every priced pick.
TELEGRAM_MIN_EV=
# Set to 1 when deployed behind exactly one reverse proxy (e.g. Render) so rate limiting sees real client IPs.
TRUST_PROXY=
# Durable history on Supabase Free. Server-side only; never put the secret in public/ or Git.
# Run supabase/schema.sql in your project's SQL Editor before setting these.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy alternative to SUPABASE_SECRET_KEY:
SUPABASE_SERVICE_ROLE_KEY=
# Server-side moneyline scanning. Start with one league to conserve free odds credits.
BACKGROUND_SCAN_SPORTS=nfl
# Random secret of at least 32 characters, shared only with Supabase Vault's sportsstat_job_token.
# Run supabase/background-jobs.sql after configuring Vault to trigger scans with the browser closed.
BACKGROUND_JOB_TOKEN=
